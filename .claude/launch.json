{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bin/rails",
      "runtimeArgs": [
        "server",
        "-p",
        "3001"
      ],
      "cwd": "backend",
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3002,
      "autoPort": true
    }
  ]
}
